[Unit]
Description=CertaRig Phase 3 live guardrail dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=certarig
Group=certarig
WorkingDirectory=/opt/certarig
EnvironmentFile=/etc/certarig/edge.env
ExecStart=/opt/certarig/.venv/bin/certarig-edge live-dashboard --config /etc/certarig/rig.json --evidence-dir /var/lib/certarig/live-runs --static-root /opt/certarig --bind 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/certarig

[Install]
WantedBy=multi-user.target
